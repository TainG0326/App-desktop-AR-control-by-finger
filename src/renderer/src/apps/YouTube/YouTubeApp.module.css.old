.shell {
  display: flex;
  flex-direction: column;
  height: 100%;
  padding: 14px;
  gap: 12px;
}

.header {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.title {
  margin: 0;
  font-size: 16px;
  font-weight: 500;
}

.subtitle {
  margin: 0;
  font-size: 12px;
  color: var(--color-text-secondary);
}

.form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.input {
  width: 100%;
  padding: 12px 14px;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: var(--color-text-primary);
  outline: none;
  font-size: 14px;
  font-family: var(--font-mono);
}

.input:focus {
  border-color: rgba(106, 169, 255, 0.5);
}

.formActions {
  display: flex;
  gap: 8px;
}

.urlDisplay {
  flex: 1;
  font-family: var(--font-mono);
  font-size: 11px;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding: 0 12px;
}

.frameWrap {
  flex: 1;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.6);
}

.iframe {
  display: block;
  width: 100%;
  height: 100%;
  border: 0;
  border-radius: inherit;
}

.errorActions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  justify-content: center;
}